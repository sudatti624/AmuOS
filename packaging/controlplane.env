# Install as /etc/amuos/controlplane.env (see INSTALL.md).
# HTTPS listen address. The default accepts connections from this machine only.
AMUOS_ADDR=127.0.0.1:8443
# Exact origin users open in the browser, without a trailing slash.
AMUOS_ORIGIN=https://localhost:8443
# mTLS address for enrolled Agents. Use 0.0.0.0:9443 (or a specific address)
# when Agents run on other hosts; the default accepts this machine only.
AMUOS_AGENT_ADDR=127.0.0.1:9443
