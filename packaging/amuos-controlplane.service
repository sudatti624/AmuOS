# Install as /etc/systemd/system/amuos-controlplane.service (see INSTALL.md).
# Stopping or restarting this service only stops the control plane itself.
[Unit]
Description=AmuOS control plane
Documentation=https://github.com/sudatti624/AmuOS
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=amuos
Group=amuos
EnvironmentFile=/etc/amuos/controlplane.env
# The TLS key stays root-only; systemd hands the service a private copy.
LoadCredential=server.pem:/etc/amuos/tls/server.pem
LoadCredential=server-key.pem:/etc/amuos/tls/server-key.pem
ExecStart=/usr/local/bin/amuos-controlplane --db /var/lib/amuos/amuos.db \
  --addr ${AMUOS_ADDR} --origin ${AMUOS_ORIGIN} \
  --tls-cert %d/server.pem --tls-key %d/server-key.pem
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

StateDirectory=amuos
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
